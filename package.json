{
  "name": "toffee",
  "version": "0.2.0",
  "description": "A minimal coffee desktop widget for tasks and notes",
  "author": "Toffee",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "playwright test",
    "package": "npm run build && node scripts/package.cjs"
  },
  "build": {
    "appId": "com.toffee.desktop",
    "productName": "Toffee",
    "directories": {
      "output": "release-v0.2"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "LICENSE",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "signExecutable": false,
      "icon": "public/assets/app-icon.ico"
    },
    "portable": {
      "artifactName": "Toffee-${version}.exe"
    }
  },
  "dependencies": {
    "@fontsource/caveat-brush": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@rolldown/binding-win32-x64-msvc": "^1.2.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
